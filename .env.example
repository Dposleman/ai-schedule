# Copy this file to .env.local and set a real secret in production.
# Used to sign session cookies. Any long random string works.
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Neon, Vercel Postgres, Supabase, Railway, or
# your own Postgres server all work). Required.
DATABASE_URL=postgres://user:password@host:5432/database

# Optional: enables real welcome emails (with the temporary password) when a
# new employee account is created. Get a free API key at https://resend.com.
# Without it, the temp password is shown once on screen instead.
RESEND_API_KEY=
# Optional: "Name <verified@yourdomain.com>". Defaults to Resend's sandbox
# sender, which can only deliver to the Resend account's own email.
EMAIL_FROM=
# Optional: public URL of your deployment, used for the "Sign in" link in
# welcome emails (e.g. https://ai-schedule-alpha.vercel.app).
NEXT_PUBLIC_APP_URL=
